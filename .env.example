# Copy to .env (or just run `npm run set-password`, which creates it for you).

# --- Login (generated by `npm run set-password`) ---
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# --- Home Assistant (leave empty to use demo devices) ---
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=   # Profile → Security → Long-lived access tokens

# --- GitHub (optional; raises the API limit for project cards) ---
# GITHUB_TOKEN=

# --- Two-factor login codes (generated by `npm run setup-2fa`; leave empty for password only) ---
# TOTP_SECRET=
